#: scripts-dev/setup.sh:132
msgid ""
"CLI Quick Reference\n"
"==================\n"
"  ./scripts-dev/setup.sh                    Interactive menu (this screen)\n"
"  ./scripts-dev/setup.sh --local-test       Build, install and test locally\n"
"  ./scripts-dev/setup.sh --clean-install    Force remove + full rebuild + "
"install\n"
"  ./scripts-dev/setup.sh --dependencies-only  Check/install build "
"dependencies\n"
"  ./scripts-dev/setup.sh --uninstall        Remove the plasmoid from Plasma\n"
"  ./scripts-dev/setup.sh --dry-run          Preview commands without "
"executing\n"
"  ./scripts-dev/setup.sh --yes              Auto-accept package manager "
"prompts\n"
"  ./scripts-dev/setup.sh --help             Show full help with all options\n"
"  ./scripts-dev/setup.sh <file.plasmoid>    Install a prebuilt package "
"directly"
msgstr ""
"Referência rápida de comandos da CLI\n"
"====================================\n"
"  ./scripts-dev/setup.sh                    Menu interativo (esta tela)\n"
"  ./scripts-dev/setup.sh --local-test       Compilar, instalar e testar "
"localmente\n"
"  ./scripts-dev/setup.sh --clean-install    Remover, recompilar e instalar "
"do zero\n"
"  ./scripts-dev/setup.sh --dependencies-only  Verificar/instalar "
"dependências de compilação\n"
"  ./scripts-dev/setup.sh --uninstall        Remover o plasmoide do Plasma\n"
"  ./scripts-dev/setup.sh --dry-run          Visualizar comandos sem executá-"
"los\n"
"  ./scripts-dev/setup.sh --yes              Aceitar automaticamente as "
"confirmações do gerenciador de pacotes\n"
"  ./scripts-dev/setup.sh --help             Mostrar ajuda completa com todas "
"as opções\n"
"  ./scripts-dev/setup.sh <arquivo.plasmoid> Instalar diretamente um pacote "
"pré-compilado"

