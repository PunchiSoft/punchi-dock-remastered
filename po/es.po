#: scripts-dev/setup.sh:132
msgid ""
"CLI Quick Reference\n"
"==================\n"
"  ./scripts-dev/setup.sh                    Interactive menu (this screen)\n"
"  ./scripts-dev/setup.sh --local-test       Build, install and test locally\n"
"  ./scripts-dev/setup.sh --clean-install    Force remove + full rebuild + "
"install\n"
"  ./scripts-dev/setup.sh --dependencies-only  Check/install build "
"dependencies\n"
"  ./scripts-dev/setup.sh --uninstall        Remove the plasmoid from Plasma\n"
"  ./scripts-dev/setup.sh --dry-run          Preview commands without "
"executing\n"
"  ./scripts-dev/setup.sh --yes              Auto-accept package manager "
"prompts\n"
"  ./scripts-dev/setup.sh --help             Show full help with all options\n"
"  ./scripts-dev/setup.sh <file.plasmoid>    Install a prebuilt package "
"directly"
msgstr ""
"Referencia rápida de comandos CLI\n"
"=================================\n"
"  ./scripts-dev/setup.sh                    Menú interactivo (esta "
"pantalla)\n"
"  ./scripts-dev/setup.sh --local-test       Compilar, instalar y probar "
"localmente\n"
"  ./scripts-dev/setup.sh --clean-install    Eliminar, recompilar e instalar "
"desde cero\n"
"  ./scripts-dev/setup.sh --dependencies-only  Verificar/instalar "
"dependencias de compilación\n"
"  ./scripts-dev/setup.sh --uninstall        Desinstalar el plasmoide de "
"Plasma\n"
"  ./scripts-dev/setup.sh --dry-run          Previsualizar comandos sin "
"ejecutarlos\n"
"  ./scripts-dev/setup.sh --yes              Aceptar automáticamente los "
"avisos del gestor de paquetes\n"
"  ./scripts-dev/setup.sh --help             Mostrar la ayuda completa con "
"todas las opciones\n"
"  ./scripts-dev/setup.sh <archivo.plasmoid> Instalar directamente un paquete "
"precompilado"

