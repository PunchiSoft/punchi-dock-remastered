#: scripts-dev/setup.sh:176
msgid ""
"CLI Quick Reference\n"
"==================\n"
"  ./scripts-dev/setup.sh                    Interactive menu (this screen)\n"
"  ./scripts-dev/setup.sh --local-test       Build, install and test locally\n"
"  ./scripts-dev/setup.sh --clean-install    Force remove + full rebuild + "
"install\n"
"  ./scripts-dev/setup.sh --dependencies-only  Check/install build "
"dependencies\n"
"  ./scripts-dev/setup.sh --uninstall        Remove the plasmoid from Plasma\n"
"  ./scripts-dev/setup.sh --dry-run          Preview commands without "
"executing\n"
"  ./scripts-dev/setup.sh --yes              Auto-accept package manager "
"prompts\n"
"  ./scripts-dev/setup.sh --help             Show full help with all options\n"
"  ./scripts-dev/setup.sh <file.plasmoid>    Install a prebuilt package "
"directly"
msgstr ""
"CLI-Kurzreferenz\n"
"================\n"
"  ./scripts-dev/setup.sh                    Interaktives Menü (dieser "
"Bildschirm)\n"
"  ./scripts-dev/setup.sh --local-test       Lokal erstellen, installieren "
"und testen\n"
"  ./scripts-dev/setup.sh --clean-install    Entfernen, vollständig neu "
"erstellen und installieren\n"
"  ./scripts-dev/setup.sh --dependencies-only  Build-Abhängigkeiten prüfen/"
"installieren\n"
"  ./scripts-dev/setup.sh --uninstall        Plasmoid aus Plasma entfernen\n"
"  ./scripts-dev/setup.sh --dry-run          Befehle ohne Ausführung "
"anzeigen\n"
"  ./scripts-dev/setup.sh --yes              Rückfragen des Paketmanagers "
"automatisch bestätigen\n"
"  ./scripts-dev/setup.sh --help             Vollständige Hilfe mit allen "
"Optionen anzeigen\n"
"  ./scripts-dev/setup.sh <datei.plasmoid>   Vorgefertigtes Paket direkt "
"installieren"

