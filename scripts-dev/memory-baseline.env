# Punchi Dock memory budget, measured with scripts-dev/memory-budget.py.
# Values are Pss_Anon deltas in MB for the environment in MEMORY_PROFILE.
# Budget = highest observed value + 1.0 MB of harness noise. A baseline may
# only decrease; MEMORY_MAX_FIRST_INSTANCE_MB stays at its previous ceiling
# because the noise margin would raise it.
MEMORY_PROFILE=fedora44-qt6.11-plasma6.7
MEMORY_MAX_FIRST_INSTANCE_MB=137.0
MEMORY_MAX_SECOND_INSTANCE_MB=97.0
MEMORY_MAX_RETENTION_MB=233.0
